<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find demo_robot_description)/urdf/robot/common_inertial.xacro"/>
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- robot imu sensor -->
        <link name="${wheel_name}_link">
            <!-- component visual description -->
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- geometric description -->
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>

                <!-- material color -->
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>        
            </visual>

            <collision>
                 <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- geometric description -->
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>

                <!-- material color -->
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>       
                
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04"/>
        </link>
        
        
            <!-- robot joint -->
        <joint name="${wheel_name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
    </xacro:macro>
    

   
</robot>


