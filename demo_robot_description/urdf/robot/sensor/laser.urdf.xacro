<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find demo_robot_description)/urdf/robot/common_inertial.xacro"/>
    <xacro:macro name="laser_xacro" params="xyz">
        <!-- robot imu sensor -->
        <link name="laser_cylinder_link">
            <!-- component visual description -->
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- geometric description -->
                <geometry>
                    <cylinder radius ="0.01" length="0.10"/>
                </geometry>

                <!-- material color -->
                <material name="black_semi_transparent">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>        
            </visual>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- geometric description -->
                <geometry>
                    <cylinder radius ="0.01" length="0.10"/>
                </geometry>

                <!-- material color -->
                <material name="black_semi_transparent">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>       
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.02" h="0.10"/>
        </link>


        <link name="laser_link">
            <!-- component visual description -->
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- geometric description -->
                <geometry>
                    <cylinder radius ="0.02" length="0.02"/>
                </geometry>

                <!-- material color -->
                <material name="black_semi_transparent">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>        
            </visual>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- geometric description -->
                <geometry>
                    <cylinder radius ="0.02" length="0.02"/>
                </geometry>

                <!-- material color -->
                <material name="black_semi_transparent">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>    
                
            </collision>
            <xacro:cylinder_inertia m="0.1" r="0.02" h="0.02"/>
        </link>

            <!-- robot joint -->
        <joint name="laser_joint" type="fixed">
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
        </joint>

        <joint name="laser_cylinder_joint" type="fixed">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
        </joint>

        
    </xacro:macro>
    

   
</robot>


